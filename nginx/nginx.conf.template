server {
    listen 80;
    server_name @@DOMAIN@@;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name @@DOMAIN@@;
    ssl_certificate     /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    root  /usr/share/nginx/html;
    index index.html;

    # ── Auth check (internal, used by auth_request) ───────────────────────────
    location = /auth/check {
        internal;
        proxy_pass http://auth:5000/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    # ── Public auth endpoints ─────────────────────────────────────────────────
    location /auth/ {
        proxy_pass http://auth:5000/auth/;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ── Invite link shortcut ──────────────────────────────────────────────────
    location ~ ^/invite/(.+)$ {
        proxy_pass http://auth:5000/auth/verify-link?key=$1;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ── Admin (Basic Auth + admin API) ────────────────────────────────────────
    location = /admin.html {
        auth_basic "Admin";
        auth_basic_user_file /etc/nginx/admin_htpasswd;
        try_files $uri =404;
    }
    location /auth/admin/ {
        auth_basic "Admin";
        auth_basic_user_file /etc/nginx/admin_htpasswd;
        proxy_pass http://auth:5000/auth/admin/;
    }

    # ── Login page (public) ───────────────────────────────────────────────────
    location = /login.html {
        try_files $uri =404;
    }

    # ── OME stream API (auth + permission filtering handled by auth service) ─────
    location /api/streams {
        proxy_pass http://auth:5000/api/streams;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store";
    }

    location ~ ^/api/stream/(.+)$ {
        proxy_pass http://auth:5000/api/stream/$1;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store";
    }

    # ── Pretty stream URL ─────────────────────────────────────────────────────
    location ~ ^/s/(.+)$ {
        return 302 /?stream=$1;
    }

    # ── Everything else: auth_request protected ───────────────────────────────
    location / {
        auth_request /auth/check;
        error_page 401 = @login_redirect;
        try_files $uri $uri/ =404;
    }

    location @login_redirect {
        return 302 /login.html;
    }
}
