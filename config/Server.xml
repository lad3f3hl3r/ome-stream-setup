<?xml version="1.0" encoding="UTF-8" ?>
<Server version="8">
    <Name>OvenMediaEngine</Name>
    <Type>origin</Type>
    <IP>*</IP>
    <PrivacyProtection>false</PrivacyProtection>
    <StunServer>stun.ovenmediaengine.com:13478</StunServer>
    <Modules>
        <HTTP2><Enable>true</Enable></HTTP2>
        <LLHLS><Enable>true</Enable></LLHLS>
        <P2P><Enable>false</Enable><MaxClientPeersPerHostPeer>2</MaxClientPeersPerHostPeer></P2P>
    </Modules>
    <Bind>
        <Managers><API><Port>8081</Port><WorkerCount>1</WorkerCount></API></Managers>
        <Providers>
            <RTMP><Port>1935</Port><WorkerCount>1</WorkerCount></RTMP>
            <SRT><Port>9999</Port><WorkerCount>1</WorkerCount></SRT>
            <WebRTC>
                <Signalling><Port>3333</Port><TLSPort>3334</TLSPort><WorkerCount>1</WorkerCount></Signalling>
                <IceCandidates>
                    <IceCandidate>${env:OME_HOST_IP:*}:10000-10009/udp</IceCandidate>
                    <TcpRelay>${env:OME_HOST_IP:*}:3478</TcpRelay>
                    <TcpForce>true</TcpForce>
                    <TcpRelayWorkerCount>1</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
        </Providers>
        <Publishers>
            <LLHLS><Port>8080</Port><TLSPort>8090</TLSPort><WorkerCount>1</WorkerCount></LLHLS>
            <WebRTC>
                <Signalling><Port>3333</Port><TLSPort>3334</TLSPort><WorkerCount>1</WorkerCount></Signalling>
                <IceCandidates>
                    <IceCandidate>${env:OME_HOST_IP:*}:10000-10009/udp</IceCandidate>
                    <TcpRelay>${env:OME_HOST_IP:*}:3478</TcpRelay>
                    <TcpForce>true</TcpForce>
                    <TcpRelayWorkerCount>1</TcpRelayWorkerCount>
                </IceCandidates>
            </WebRTC>
        </Publishers>
    </Bind>
    <Managers>
        <Host><Names><Name>*</Name></Names></Host>
        <API><AccessToken>@@OME_API_TOKEN@@</AccessToken></API>
    </Managers>
    <Defaults>
        <CrossDomains><Url>*</Url></CrossDomains>
    </Defaults>
    <VirtualHosts>
        <VirtualHost>
            <Name>default</Name>
            <Host>
                <Names>
                    <Name>@@DOMAIN@@</Name>
                    <Name>*</Name>
                </Names>
                <TLS>
                    <CertPath>/etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem</CertPath>
                    <KeyPath>/etc/letsencrypt/live/@@DOMAIN@@/privkey.pem</KeyPath>
                </TLS>
            </Host>
            <Applications>
                <Application>
                    <Name>live</Name>
                    <Type>live</Type>
                    <!-- Block RTMP/SRT streams without correct secret prefix -->
                    <AdmissionWebhooks>
                        <ControlServerUrl>http://127.0.0.1:5001/ome-hook</ControlServerUrl>
                        <SecretKey></SecretKey>
                        <Timeout>3000</Timeout>
                        <Enables>
                            <Publishers>rtmp,srt</Publishers>
                        </Enables>
                    </AdmissionWebhooks>

                    <OutputProfiles>

                        <!-- WebRTC primary: full-quality bypass -->
                        <OutputProfile>
                            <Name>original</Name>
                            <OutputStreamName>${OriginStreamName}</OutputStreamName>
                            <Encodes>
                                <Video><Name>bypass_video</Name><Bypass>true</Bypass></Video>
                                <Audio><Name>aac_audio</Name><Codec>aac</Codec><Bitrate>128000</Bitrate><Samplerate>48000</Samplerate><Channel>2</Channel><BypassIfMatch><Codec>eq</Codec></BypassIfMatch></Audio>
                                <Audio><Name>opus_audio</Name><Codec>opus</Codec><Bitrate>128000</Bitrate><Samplerate>48000</Samplerate><Channel>2</Channel><BypassIfMatch><Codec>eq</Codec></BypassIfMatch></Audio>
                            </Encodes>
                        </OutputProfile>

                        <!-- LLHLS ABR: multi-rendition master playlist for native quality picker -->
                        <OutputProfile>
                            <Name>abr</Name>
                            <OutputStreamName>${OriginStreamName}_abr</OutputStreamName>
                            <Playlist>
                                <Name>llhls_default</Name>
                                <FileName>llhls</FileName>
                                <Options>
                                    <WebRtcAutoAbr>false</WebRtcAutoAbr>
                                    <HLSChunklistPathDepth>-1</HLSChunklistPathDepth>
                                    <EnableTsPackaging>false</EnableTsPackaging>
                                </Options>
                                <RenditionTemplate>
                                    <Name>${Height}p</Name>
                                    <VideoTemplate>
                                        <EncodingType>all</EncodingType>
                                    </VideoTemplate>
                                    <AudioTemplate>
                                        <VariantName>aac_audio</VariantName>
                                    </AudioTemplate>
                                </RenditionTemplate>
                            </Playlist>
                            <Encodes>
                                <Video><Name>bypass_video</Name><Bypass>true</Bypass></Video>
                                <Video><Name>video_1080</Name><Codec>h264</Codec><Bitrate>5000000</Bitrate><Framerate>30</Framerate><Height>1080</Height><Preset>faster</Preset></Video>
                                <Video><Name>video_720</Name><Codec>h264</Codec><Bitrate>2500000</Bitrate><Framerate>30</Framerate><Height>720</Height><Preset>faster</Preset></Video>
                                <Video><Name>video_480</Name><Codec>h264</Codec><Bitrate>1000000</Bitrate><Framerate>30</Framerate><Height>480</Height><Preset>faster</Preset></Video>
                                <Audio><Name>aac_audio</Name><Codec>aac</Codec><Bitrate>128000</Bitrate><Samplerate>48000</Samplerate><Channel>2</Channel><BypassIfMatch><Codec>eq</Codec></BypassIfMatch></Audio>
                                <Audio><Name>opus_audio</Name><Codec>opus</Codec><Bitrate>128000</Bitrate><Samplerate>48000</Samplerate><Channel>2</Channel><BypassIfMatch><Codec>eq</Codec></BypassIfMatch></Audio>
                            </Encodes>
                        </OutputProfile>

                        <!-- Audio only -->
                        <OutputProfile>
                            <Name>audio_only</Name>
                            <OutputStreamName>${OriginStreamName}_audio</OutputStreamName>
                            <Encodes>
                                <Audio><Name>aac_audio</Name><Codec>aac</Codec><Bitrate>192000</Bitrate><Samplerate>48000</Samplerate><Channel>2</Channel><BypassIfMatch><Codec>eq</Codec></BypassIfMatch></Audio>
                                <Audio><Name>opus_audio</Name><Codec>opus</Codec><Bitrate>192000</Bitrate><Samplerate>48000</Samplerate><Channel>2</Channel><BypassIfMatch><Codec>eq</Codec></BypassIfMatch></Audio>
                            </Encodes>
                        </OutputProfile>

                    </OutputProfiles>
                    <Providers>
                        <RTMP/>
                        <SRT/>
                        <WebRTC>
                            <Timeout>30000</Timeout>
                            <CrossDomains><Url>*</Url></CrossDomains>
                        </WebRTC>
                    </Providers>
                    <Publishers>
                        <AppWorkerCount>1</AppWorkerCount>
                        <StreamWorkerCount>8</StreamWorkerCount>
                        <WebRTC>
                            <Timeout>30000</Timeout>
                            <Rtx>false</Rtx>
                            <Ulpfec>false</Ulpfec>
                            <JitterBuffer>false</JitterBuffer>
                            <CreateDefaultPlaylist>true</CreateDefaultPlaylist>
                        </WebRTC>
                        <LLHLS>
                            <OriginMode>true</OriginMode>
                            <ChunkDuration>0.5</ChunkDuration>
                            <PartHoldBack>1.5</PartHoldBack>
                            <SegmentDuration>6</SegmentDuration>
                            <SegmentCount>10</SegmentCount>
                            <DVR>
                                <Enable>true</Enable>
                                <TempStoragePath>/tmp/ome_dvr/</TempStoragePath>
                                <MaxDuration>3600</MaxDuration>
                            </DVR>
                            <CrossDomains><Url>*</Url></CrossDomains>
                            <CreateDefaultPlaylist>true</CreateDefaultPlaylist>
                        </LLHLS>
                    </Publishers>
                </Application>
            </Applications>
        </VirtualHost>
    </VirtualHosts>
</Server>
