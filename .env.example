# Copy to .env and fill in your values
DOMAIN=stream.example.com
OME_HOST_IP=1.2.3.4
EMAIL=you@example.com
TZ=Europe/Vienna

# OME REST API token — used internally between nginx and OME
OME_API_TOKEN=change-me-api-token

# Secret prefix for OBS stream keys: FORMAT → SECRET~StreamName
STREAM_SECRET=changeme

# Viewer PIN (6 digits)
VIEWER_PIN=000000
