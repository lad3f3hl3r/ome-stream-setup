# Copy to .env and fill in your values
DOMAIN=stream.example.com
OME_HOST_IP=1.2.3.4
EMAIL=you@example.com
TZ=Europe/Vienna

# TLS_MODE:
#   certbot   — obtain Let's Encrypt cert (default, requires port 80 reachable from internet)
#   selfsigned — generate self-signed cert (dev/internal use)
#   proxy     — no TLS on nginx, reverse proxy handles HTTPS; LLHLS routed through nginx
TLS_MODE=certbot

# OME REST API token — used internally between nginx and OME
OME_API_TOKEN=change-me-api-token

# Stream secret — must prefix every OBS stream key: SECRET~StreamName
STREAM_SECRET=changeme

# Admin page password (HTTP Basic Auth)
ADMIN_PASSWORD=changeme-admin

# LLHLS and WebRTC ports (used in config.js for the player)
# Set to empty for proxy mode (traffic routed through port 443 via reverse proxy)
LLHLS_PORT=8090
WEBRTC_PORT=3334

# SMTP — for magic link emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
# Wrap password in single quotes if it contains special characters (& ; # etc)
SMTP_PASS='your-smtp-password'
SMTP_FROM=noreply@example.com
SMTP_TLS=true    # STARTTLS on port 587
SMTP_SSL=false   # SSL on port 465 (set true + port 465 if using SMTPS)

# Optional tuning
MAGIC_LINK_EXPIRE_MINUTES=15
SESSION_EXPIRE_DAYS=7
